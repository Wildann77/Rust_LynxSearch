{
  "name": "lynxsearch",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop search engine for developer knowledge bases",
  "scripts": {
    "dev": "npm --prefix apps/desktop run dev",
    "dev:desktop": "npm --prefix apps/desktop run dev",
    "dev:tauri": "npm --prefix apps/desktop run tauri dev",
    "build": "npm --prefix apps/desktop run build",
    "build:desktop": "npm --prefix apps/desktop run build",
    "build:visualize": "npm --prefix apps/desktop run build:visualize",
    "lint": "npm --prefix apps/desktop run lint",
    "lint:fix": "npm --prefix apps/desktop run lint:fix",
    "lint:desktop": "npm --prefix apps/desktop run lint",
    "typecheck": "npm --prefix apps/desktop run typecheck",
    "typecheck:desktop": "npm --prefix apps/desktop run typecheck",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm --prefix apps/desktop run test",
    "test:coverage": "npm --prefix apps/desktop run test:coverage",
    "test:backend": "cargo nextest run --all-features",
    "check:bundle": "python3 scripts/bundle-budget-checker.py --max-js 450 --max-css 50",
    "fmt:check": "cargo fmt --check",
    "fmt:fix": "cargo fmt",
    "clippy": "cargo clippy --all-targets --all-features -- -D warnings",
    "quality": "npm run fmt:check && npm run clippy && npm run test:backend && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:bundle"
  },
  "keywords": [
    "desktop-search",
    "tauri",
    "rust",
    "react",
    "elasticsearch"
  ],
  "author": "LynxSearch Contributors",
  "license": "MIT"
}
