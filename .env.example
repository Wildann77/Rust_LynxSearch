# Database & Container Credentials (PostgreSQL 18.6)
POSTGRES_USER=lynx
POSTGRES_PASSWORD=lynxpass
POSTGRES_DB=lynxsearch
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}

# Search Engine Configuration (Elasticsearch 8.19.22)
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_ALIAS=lynx_documents

# Backend Service Configuration (Axum 0.8 / Rust 1.98.1)
BACKEND_BIND_ADDR=127.0.0.1:3001
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
RUST_LOG=info,backend=debug

# Ingestion & Search Engine Defaults
DEFAULT_MAX_FILE_SIZE_BYTES=2097152
DEFAULT_IGNORE_PATTERNS=.git,node_modules,target,dist,build
DEFAULT_BM25_TITLE_WEIGHT=3.0
DEFAULT_BM25_TAGS_WEIGHT=2.0
DEFAULT_BM25_CONTENT_WEIGHT=1.0
FILE_READ_CONCURRENCY_LIMIT=50

# Desktop Client Configuration (Vite 8.1 / Tauri 2.12)
VITE_BACKEND_URL=http://127.0.0.1:3001

